# ============================================================
# FormaPro Frontend — Variables d'environnement
# Copier ce fichier en .env.production et remplir les valeurs
# Les variables VITE_ sont intégrées au bundle au moment du build
# NE JAMAIS mettre de secrets ici (clés privées, mots de passe)
# ============================================================

# URL de l'API backend (Render)
VITE_API_URL=https://<votre-backend>.onrender.com/api

# Nom de l'application
VITE_APP_NAME=FormaPro
